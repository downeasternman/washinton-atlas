{
  "name": "washington-county-atlas",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "etl:boundaries": "tsx scripts/etl/download-boundaries.ts",
    "etl:osm": "tsx scripts/etl/download-osm.ts",
    "tiles:boundaries": "tsx scripts/tiles/build-boundaries.ts",
    "tiles:basemap": "tsx scripts/tiles/build-basemap.ts",
    "tiles:all": "pnpm tiles:boundaries && pnpm tiles:basemap",
    "phase:b": "pnpm etl:boundaries && pnpm etl:osm && pnpm tiles:all"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "drizzle-orm": "^0.45.2",
    "geojson-vt": "^4.0.3",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.12",
    "pmtiles": "^4.4.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.1",
    "sql.js": "^1.14.1",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
